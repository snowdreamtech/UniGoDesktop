{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "UniGoDesktop",
  "outputfilename": "unigodesktop",
  "frontend:dir": "frontend",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build",
  "frontend:dev:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "devServer": "localhost:34115",
  "wailsjsdir": "./frontend",
  "preBuildHooks": {
    "*/*": "node -e \"import((require('node:fs').existsSync('scripts/prepare-app-icon.mjs')?'./scripts':'../../scripts')+'/prepare-app-icon.mjs')\""
  },
  "nsisType": "multiple",
  "author": {
    "name": "SnowdreamTech",
    "email": "snowdreamtech@qq.com"
  },
  "windows": {
    "webview2": "download"
  },
  "info": {
    "companyName": "SnowdreamTech",
    "productName": "UniGoDesktop",
    "productVersion": "0.9.0",
    "copyright": "Copyright (c) 2026 SnowdreamTech. All rights reserved.",
    "comments": "Universal Go Desktop Suite"
  }
}
